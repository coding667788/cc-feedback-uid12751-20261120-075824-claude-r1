        },
        {
          "op": "register_policy",
          "request_id": "c7-r4",
          "version": 2,
          "coverage": [
            {
              "partition": 0,
              "effective_offset": 1
            }
          ],
          "rules": [
            {
              "subscriber": "other",
              "pattern": "orders.*",
              "effect": "allow"
            }
          ]
        },
        {
          "op": "publish",
          "request_id": "c7-r3",
          "partition": 0,
          "offset": 0,
          "payload": {
            "order": "A-1"
          }
        },
        {
          "op": "publish",
          "request_id": "c7-r3",
          "partition": 0,
          "offset": 0,
          "payload": {
            "order": "A-2"
          }
